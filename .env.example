# --- Required secrets (never commit real values) ---
# Random long string used to sign session tokens and download links
APP_SECRET=change-me-to-a-long-random-string

# Admin account created on first run
ADMIN_EMAIL=admin@fileshelf.ug
ADMIN_PASSWORD=change-me-strong-password

# --- MarzPay (MTN MoMo + Airtel Money in Uganda) ---
# From your MarzPay dashboard API credentials export
MARZ_API_KEY=marz_xxxxxxxx
MARZ_API_SECRET=xxxxxxxx
# Public base URL of this app (used as the MarzPay payment webhook URL), e.g.
APP_URL=http://localhost:3000
