{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fileshelf",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-12-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fileshelf-db",
      "database_id": "1cd4ac7e-5ce3-4b7e-9e14-d23a2befd751"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "fileshelf-storage"
    }
  ],
  "vars": {
    "APP_URL": "https://fileshelf.your-subdomain.workers.dev"
  }
}
